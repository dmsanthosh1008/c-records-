#include &lt;iostream&gt;
#include &lt;cassert&gt;
using namespace std;
class Matrix
{
private:
int data[2][2];
public:
Matrix(int a = 0, int b = 0, int c = 0, int d = 0)
{
data[0][0] = a;
data[0][1] = b;
data[1][0] = c;
data[1][1] = d;
}
// Operator +
Matrix operator+(const Matrix &amp;m)
{
Matrix result;
for (int i = 0; i &lt; 2; i++)
for (int j = 0; j &lt; 2; j++)
result.data[i][j] = data[i][j] + m.data[i][j];
return result;
}
// Operator *
Matrix operator*(const Matrix &amp;m)
{
Matrix result;
for (int i = 0; i &lt; 2; i++)
{
for (int j = 0; j &lt; 2; j++)
{
result.data[i][j] = 0;

for (int k = 0; k &lt; 2; k++)
result.data[i][j] += data[i][k] * m.data[k][j];
}
}
return result;
}
// Operator []
int* operator[](int index)
{
return data[index];
}
// Operator &lt;&lt;
friend ostream&amp; operator&lt;&lt;(ostream &amp;out, const Matrix &amp;m)
{
for (int i = 0; i &lt; 2; i++)
{
for (int j = 0; j &lt; 2; j++)
out &lt;&lt; m.data[i][j] &lt;&lt; &quot; &quot;;

out &lt;&lt; endl;
}
return out;
}
};
int main()
{
Matrix A(1, 2, 3, 4);
Matrix B(5, 6, 7, 8);

Matrix sum = A + B;
Matrix product = A * B;
// Unit Tests
assert(sum[0][0] == 6);
assert(sum[1][1] == 12);
assert(product[0][0] == 19);
assert(product[0][1] == 22);
assert(product[1][0] == 43);
assert(product[1][1] == 50);
cout &lt;&lt; &quot;Matrix A:&quot; &lt;&lt; endl;
cout &lt;&lt; A;
cout &lt;&lt; &quot;Matrix B:&quot; &lt;&lt; endl;
cout &lt;&lt; B;
cout &lt;&lt; &quot;Addition of Matrices:&quot; &lt;&lt; endl;
cout &lt;&lt; sum;
cout &lt;&lt; &quot;Multiplication of Matrices:&quot; &lt;&lt; endl;
cout &lt;&lt; product;
cout &lt;&lt; &quot;All unit tests passed successfully.&quot; &lt;&lt; endl;
return 0;
}
